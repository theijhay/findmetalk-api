# Copy to .env for local development: `cp .env.example .env`.
# Every variable the deployment needs is listed here, with what it gates.
# A pull request that adds a setting adds it here in the same change.

# ---- App ---------------------------------------------------------------------
# The product name shown in the API title and, later, in emails. Never written
# into code (spec: "Never hardcode the name").
APP_NAME=FindMeTalk
# development | test | staging | production. production turns off /docs and
# /openapi.json (the contract is published from contract/ instead).
APP_ENV=development
# Reloads the server on code changes when started with `make run`. Never true
# on a deployment.
DEBUG=true
APP_PORT=8000
# DEBUG | INFO | WARNING | ERROR. Logs are JSON on stdout and carry no PII.
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API: findmetalk-web and
# findmetalk-admin. On a deployment, their real https:// origins only.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- PostgreSQL --------------------------------------------------------------
# Source of truth for everything durable. Local: `make up` (host port 5434).
# On DigitalOcean, the managed database's connection string, which ends in
# ?sslmode=require; that form is accepted as-is.
DB_URL=postgresql://findmetalk:findmetalk@localhost:5434/findmetalk
# Connections per API instance: pool + overflow, kept well under the managed
# database's connection limit across all instances.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---- Redis -------------------------------------------------------------------
# Presence, call locks and guardrail counters. Local: `make up` (host port
# 6381). On DigitalOcean, the managed Redis/Valkey URL (rediss:// for TLS).
REDIS_URL=redis://localhost:6381/0

# ---- Runtime configuration (FR-CALL-5, REC-8) ---------------------------------
# These are Postgres config keys, not environment variables. Missing rows use
# api/utils/settings.py defaults; cached reads expire after 30 seconds.
# calls.ring_timeout_seconds: 20 (5..60), time to accept an incoming request.
# calls.recall_cooldown_seconds: 3600 (0..604800), same-pair request cooldown.
# calls.request_burst_per_hour: 30 (1..1000), invisible request burst guardrail.
# calls.max_duration_seconds: 21600 (600..86400), runaway-session ceiling.
# calls.reconnect_window_seconds: 15 (5..120), time to recover a lost connection.
# presence.heartbeat_ttl_seconds: 30 (10..120), expiry of open presence.
# circles.max_size: 8 (3..50), maximum participants in a circle.
# safety.autoflag_reporter_threshold: 3 (2..50), distinct reporters to flag.
# safety.autoflag_window_hours: 24 (1..720), window for distinct reporters.
# recordings.retention_days: 14 (1..365), recording retention window.
# recordings.enabled: default call=true/circle=true, no country overrides.
# consent.rules_version: "1", community rules version to accept.
# consent.recording_notice_version: "1", recording notice version to accept.
